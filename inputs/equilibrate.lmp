# LAMMPS Input Script
# LAMMPS version: 30Mar2026
# Author: Simon Gravelle
# License: GNU General Public License v3.0
# Project: NMRDfromMD – https://nmrdfrommd.github.io
# Description: Parameter file for simulating water

units real
atom_style full
bond_style harmonic
angle_style harmonic
pair_style lj/cut/tip4p/long 1 2 1 1 0.1546 14.0
kspace_style pppm/tip4p 1.0e-5

read_data initial.data
include parameters-h2o.inc

# define groups
group H2O type 1 2
group HYD type 2

# dynamics
timestep 0.1
fix myshk H2O shake 1.0e-5 200 0 b 1 a 1
fix mynve all nve/limit 0.1
fix myber all temp/berendsen 1 1 10

# output
thermo 1000
dump mydump all atom 1000 equilibrate.lammpstrj

# run
run 10000
unfix mynve
unfix myber

# dynamics
timestep 0.5
fix mynvt all nvt temp 300 300 50

run 10000
unfix mynvt

# dynamics
timestep 2
fix mynpt all npt temp 300 300 100 iso 1 1 1000

# output
thermo 10000

# run
run 500000

write_data equilibrate.data

